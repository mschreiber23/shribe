# Copy this file to .env and fill in your values

# Required for the "Scan Photo" feature (import workout plans from images)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Secret key for signing login tokens — change this to any long random string
JWT_SECRET=change-this-to-a-long-random-secret

# Whoop integration (optional) — get these from developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://shribetrakr.com/api/whoop/callback

# Optional: change the port the server runs on (default: 3001)
# PORT=3001
